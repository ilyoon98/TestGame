var _symbol := "seal"
var _ink := Color.WHITE


func setup(symbol: String, ink: Color, extent: int) -> void:
	_symbol = symbol
	_ink = ink
	custom_minimum_size = Vector2(extent, extent)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	resized.connect(queue_redraw)


func _draw() -> void:
	var extent := minf(size.x, size.y)
	var unit := extent / 24.0
	var origin := (size - Vector2(extent, extent)) / 2.0
	for stroke: Array in STROKES.get(_symbol, STROKES.seal):
		var points := PackedVector2Array()
		for i in range(0, stroke.size(), 2):
			points.append(origin + Vector2(stroke[i], stroke[i + 1]) * unit)
		draw_polyline(points, _ink, maxf(1.2, 1.65 * unit), true)
