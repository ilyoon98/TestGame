; Engine configuration file.
config_version=5

[application]
config/name="붕괴 통로"
run/main_scene="res://ui/startup.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=740
window/size/window_width_override=1100
window/size/window_height_override=740
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.059, 0.071, 0.055, 1)
